  {
    "name": "create_warning",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "warning": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "assetId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "watch",
                "critical"
              ]
            },
            "ownerId": {
              "type": "string"
            },
            "dueAt": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "open",
                "owned",
                "escalated",
                "resolved"
              ]
            },
            "escalationLevel": {
              "type": "number"
            },
            "readback": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nextAction": {
              "type": "string"
            },
            "createdAt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "assetId",
            "title",
            "severity",
            "ownerId",
            "dueAt",
            "state",
            "escalationLevel",
            "readback",
            "evidence",
            "nextAction",
            "createdAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "warning"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "assign_owner",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
