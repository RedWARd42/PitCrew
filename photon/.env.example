# Photon / Spectrum project credentials — from app.photon.codes →
# your project → Settings. Copy this file to `.env` and fill in.
# (Spectrum also reads these names natively; load them with your
# process manager or `node --env-file=.env` — tsx picks up .env via
# --env-file too: `npx tsx --env-file=.env src/index.ts`.)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Set to 1 to also serve the terminal provider alongside iMessage
# (handy for local development; leave unset in production).
PHOTON_TERMINAL=

# The fleet's public number, as shown in the dashboard after you add
# an iMessage line and an SMS number. The Flutter app displays this
# same number on its Fleet Line card via --dart-define.
PHOTON_FLEET_NUMBER=
